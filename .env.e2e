# Environment for the end-to-end suite. Every value here is deliberately fake.
#
# The host must not resolve: Playwright intercepts every request to it, so an
# unstubbed call fails loudly instead of quietly reaching a real database. The
# first label becomes supabase-js's storage key (`sb-e2etest-auth-token`), which
# is how tests seed a session without going near the login form.
VITE_SUPABASE_URL=https://e2etest.supabase.invalid
VITE_SUPABASE_PUBLISHABLE_KEY=e2e-anon-key-not-a-secret
VITE_HELP_URL=https://help.e2e.invalid

# Environment for the DEV Supabase stack (docker-compose.dev-supabase.yml).
#
# Paste the filled-in version into the Dokploy compose resource
# "cash-flow-dev-supabase" (Environment tab). Do NOT reuse the production
# secrets: dev gets its own JWT secret and its own anon/service keys.
#
# Generate the secrets with:
#   bash docker/scripts/gen-keys.sh
# and take POSTGRES_PASSWORD, JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY,
# DASHBOARD_PASSWORD from its output (the REALTIME_* ones are unused here).
# METRICS_TOKEN from the same run belongs to the dev *app* resource.

POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=

JWT_EXPIRY=3600
PGRST_DB_SCHEMAS=public,storage,graphql_public

# Public origin of this Supabase instance (Traefik -> kong:8000).
SUPABASE_PUBLIC_URL=https://dev-cash-flow-supabase.wi-wo.ch
API_EXTERNAL_URL=https://dev-cash-flow-supabase.wi-wo.ch

# Where GoTrue is allowed to send people back to. The app always passes
# window.location.origin, so every origin you open the dev app from belongs here.
SITE_URL=https://dev-cash-flow.wi-wo.ch
ADDITIONAL_REDIRECT_URLS=https://dev-cash-flow.wi-wo.ch/*,http://localhost:8080/*,http://localhost:3000/*

DISABLE_SIGNUP=false
# No SMTP on dev, so sign-ups confirm themselves.
ENABLE_EMAIL_AUTOCONFIRM=true

# Docker network shared with the dev app resource; create it once with
#   docker network create cash-flow-dev-supabase
DEV_SUPABASE_NETWORK=cash-flow-dev-supabase

# Uncomment to also run pg-meta + Studio (adds ~155 MB RSS):
# COMPOSE_PROFILES=studio

# ====================================================================
# Cash-Flow stack (Node SSR + External Supabase) — env vars
# Copy to .env (locally) or Dokploy Environment Variables.
# ====================================================================

# ---------- Supabase (External) ----------
# Client-facing URL and anonymous key (embedded at build time)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Server-side environment variables (required for API endpoints)
# Often SUPABASE_URL is the same as VITE_SUPABASE_URL
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-share-this

# ---------- User guide ----------
# Origin of the published help site (help-site/, deployed separately).
# REQUIRED: the build fails without it. It is inlined into the client bundle,
# so a blank value would ship as an empty string and turn every link to the
# guide into a path relative to the app's own host.
VITE_HELP_URL=https://help.cash-flow.wi-wo.ch

# ---------- Security / Observability ----------
# A secure token used to access /api/public/metrics and /api/public/prune-audit
METRICS_TOKEN=change-me-to-a-secure-random-string

# ---------- Ports ----------
APP_HOST_PORT=3000

# ---------- Nextcloud ----------
# Nothing to set. Each user connects their own Nextcloud from Settings with
# their own OAuth client id and secret, and the OAuth state is a nonce stored
# on the user's row, so no instance-wide secret is involved.

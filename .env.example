# ====================================================================
# Self-hosted Cash-Flow stack — environment variables
# Copy to .env (locally) or paste into Coolify's Environment UI.
# Never commit a real .env file.
# ====================================================================

# ---------- Public URLs ----------
# Where the app is reachable (browser-facing). Used as Supabase Site URL.
APP_PUBLIC_URL=https://app.example.com
# Where Supabase's kong gateway is reachable (browser-facing). The browser
# bundle is built against this URL.
SUPABASE_PUBLIC_URL=https://supabase.example.com
# Optional extra OAuth redirect URLs, comma-separated.
ADDITIONAL_REDIRECT_URLS=

# ---------- Postgres ----------
# Long random password. Used by every Supabase service to talk to db.
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# ---------- JWT ----------
# Secret used by GoTrue, PostgREST, Realtime to sign/verify JWTs.
# Must be >= 32 chars. See `bash docker/scripts/gen-keys.sh` to generate
# a matching JWT_SECRET + ANON_KEY + SERVICE_ROLE_KEY triple.
JWT_SECRET=change-me-32-chars-minimum-secret-value
JWT_EXPIRY=3600
# JWT issued to anon (browser) calls. Generate with the helper script.
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....
# JWT for trusted server-side calls (bypasses RLS). KEEP SECRET.
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# ---------- Realtime ----------
# 16-byte hex (32 chars) — `openssl rand -hex 16`
REALTIME_ENC_KEY=
# 64+ char random — `openssl rand -base64 64 | tr -d '\n'`
REALTIME_SECRET_KEY_BASE=

# ---------- Studio ----------
# Studio is bound to 127.0.0.1 only; tunnel via SSH to reach it.
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=change-me

# ---------- App identity / observability ----------
SUPABASE_PROJECT_ID=self-hosted
LOG_SERVICE_NAME=cash-flow
METRICS_TOKEN=change-me-bearer-for-/api/public/metrics
AUDIT_RETENTION_DAYS=365

# ---------- Ports (host-side; Coolify can override) ----------
APP_HOST_PORT=3000
KONG_HOST_PORT=8000
STUDIO_HOST_PORT=3001

# ---------- Email (optional, for Auth confirmation/recovery) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Cash Flow
MAILER_AUTOCONFIRM=false
DISABLE_SIGNUP=false

# ---------- Google OAuth (optional) ----------
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Nextcloud (optional, used by attachments feature) ----------
NEXTCLOUD_BASE_URL=
NEXTCLOUD_CLIENT_ID=
NEXTCLOUD_CLIENT_SECRET=